#!/bin/sh
# Setup new machine - CLI tool
# Usage: ./run-playbook [preset] [target] [options] [--help]
#
# Presets:
#   base    - locale, basic packages, zsh, git, fzf, tmux, mise, dotfiles, chrony, lazygit
#   dev     - base
#   full    - dev + unattended-upgrades, docker
#   minimal - only essential packages
#   portable-lab - Prepare a Debian/Ubuntu host for Incus and Firecracker
#
# Targets:
#   docker  - Use Docker test container (default)
#   local   - Run locally
#   remote  - Use hosts file (pi5-neo.local)

set -e

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Tags mapping
BASE_TAGS="locale,base,zsh,git,fzf,dotfiles,mise,tmux,chrony,lazygit"
DEV_TAGS="locale,base,zsh,git,fzf,dotfiles,mise,tmux,chrony,lazygit"
FULL_TAGS="all"
MINIMAL_TAGS="locale,base"
SIMPLE_TAGS="locale,base,git,fzf,dotfiles,mise,tmux,chrony,unattended-upgrades,lazygit"
PORTABLE_LAB_TAGS="all"
PLAYBOOK="${ANSIBLE_PLAYBOOK:-setup.yml}"

# All available tags
ALL_TAGS="base zsh git fzf rust mise dotfiles tmux unattended-upgrades docker chrony locale lazygit common networking nftables containerd incus firecracker monitoring"

# Show help
show_help() {
  echo "Usage: ./run-playbook [preset] [target] [options]"
  echo ""
  echo "Presets:"
  echo "  base    - Basic setup (locale, packages, zsh, git, fzf, tmux, mise, dotfiles, chrony, lazygit)"
  echo "  dev     - Development (base)"
  echo "  full    - Full setup (dev + unattended-upgrades, docker)"
  echo "  minimal - Minimal packages only"
  echo "  simple  - Essentials (base + git, fzf, dotfiles, mise, no zsh)"
  echo "  portable-lab - Prepare a Debian/Ubuntu host for Incus and Firecracker"
  echo ""
  echo "Targets:"
  echo "  docker  - Docker test container (default)"
  echo "  local   - Run locally (sudo)"
  echo "  remote  - Use hosts file (pi5-neo.local)"
  echo ""
  echo "Options:"
  echo "  --tags TAGS    - Run specific tags (comma-separated)"
  echo "  --playbook FILE - Run a specific playbook (default: setup.yml)"
  echo "  --list        - List available tags"
  echo "  --help        - Show this help"
  echo ""
  echo "Examples:"
  echo "  ./run-playbook           # Interactive mode"
  echo "  ./run-playbook base      # Base preset on Docker"
  echo "  ./run-playbook dev remote # Dev preset on remote machine"
  echo "  ./run-playbook --tags zsh,git  # Custom tags on Docker"
  echo "  ./run-playbook --list    # List all tags"
}

# List tags
list_tags() {
  echo "${BOLD}Available tags:${NC}"
  for tag in $ALL_TAGS; do
    echo "  $tag"
  done
}

# Docker inventory
get_docker_inventory() {
  cat >/tmp/docker_hosts_$$ <<'EOF'
[all:children]
new_machine
portable_lab

[new_machine]
localhost ansible_port=2222 ansible_user=ubuntu ansible_password=ubuntu ansible_become_password=ubuntu ansible_python_interpreter=/usr/bin/python3

[portable_lab]
localhost
EOF
  echo /tmp/docker_hosts_$$
}

# Local inventory
get_local_inventory() {
  cat >/tmp/local_hosts_$$ <<'EOF'
[all:children]
new_machine
portable_lab

[new_machine]
localhost ansible_connection=local ansible_become_password=sudo

[portable_lab]
localhost
EOF
  echo /tmp/local_hosts_$$
}

# Get single node inventory
get_single_node_inventory() {
  NODE=$1
  BECOME_PASSWORD=$2
  cat >/tmp/single_node_$$ <<EOF
[all:children]
new_machine
portable_lab

[new_machine]
${NODE} ansible_become_password=${BECOME_PASSWORD}

[portable_lab]
${NODE}
EOF
  echo /tmp/single_node_$$
}

# Ensure docker is running
ensure_docker() {
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q ubuntu_test_container; then
    echo "${YELLOW}Starting docker test environment...${NC}"
    ./docker-build 2>/dev/null
    ./docker-run 2>/dev/null
    sleep 2
  fi
}

# Run ansible
run_playbook() {
  INVENTORY=$1
  TAGS=$2

  if [ "$TARGET" = "docker" ]; then
    ensure_docker
  fi

  ansible-playbook -i "$INVENTORY" "$PLAYBOOK" --tags "$TAGS"
}

# Parse arguments
# Handle options first
case "${1:-}" in
--help | -h)
  show_help
  exit 0
  ;;
--list | -l)
  list_tags
  exit 0
  ;;
esac

# Parse preset
PRESET=""
TAGS=""
case "${1:-}" in
base | dev | full | minimal | simple | portable-lab)
  PRESET="$1"
  shift
  ;;
--tags=*)
  TAGS=$(echo "$1" | cut -d= -f2)
  shift
  ;;
--tags | -t)
  TAGS="$2"
  shift 2
  ;;
--playbook=*)
  PLAYBOOK=$(echo "$1" | cut -d= -f2)
  shift
  ;;
--playbook)
  PLAYBOOK="$2"
  shift 2
  ;;
esac

# Parse target
TARGET="${1:-docker}"
case $TARGET in
docker | local | remote) ;;
*)
  echo "Unknown target: $TARGET"
  show_help
  exit 1
  ;;
esac

# Parse remaining args
while [ $# -gt 0 ]; do
  case "$1" in
  --tags=*) TAGS=$(echo "$1" | cut -d= -f2) ;;
  --tags | -t)
    TAGS="$2"
    shift
    ;;
  --playbook=*) PLAYBOOK=$(echo "$1" | cut -d= -f2) ;;
  --playbook)
    PLAYBOOK="$2"
    shift
    ;;
  docker | local | remote) TARGET="$1" ;;
  esac
  shift
done

# Set tags from preset
if [ -z "$TAGS" ] && [ -n "$PRESET" ]; then
  case $PRESET in
  base) TAGS="$BASE_TAGS" ;;
  dev) TAGS="$DEV_TAGS" ;;
  full) TAGS="$FULL_TAGS" ;;
  minimal) TAGS="$MINIMAL_TAGS" ;;
  simple) TAGS="$SIMPLE_TAGS" ;;
  portable-lab)
    TAGS="$PORTABLE_LAB_TAGS"
    PLAYBOOK="playbooks/portable-lab.yml"
    ;;
  esac
fi

# Get inventory
case $TARGET in
docker) INVENTORY=$(get_docker_inventory) ;;
local) INVENTORY=$(get_local_inventory) ;;
remote)
  echo ""
  echo "${BOLD}Available nodes:${NC}"
  grep -v '^\[' hosts | grep -v '^$' | nl -s ') '
  echo ""
  printf "Select node number: "
  read node_choice
  NODE=$(grep -v '^\[' hosts | grep -v '^$' | sed -n "${node_choice}p")
  if [ -z "$NODE" ]; then
    echo "Invalid selection"
    exit 1
  fi
  printf "sudo password: "
  read -s BECOME_PASSWORD
  echo ""
  INVENTORY=$(get_single_node_inventory "$NODE" "$BECOME_PASSWORD")
  ;;
esac

# Run
if [ -z "$TAGS" ]; then
  echo "${BOLD}Select setup:${NC}"
  echo "  1) base    - Basic setup (locale, packages, zsh, git, fzf, tmux, dotfiles, chrony, lazygit)"
  echo "  2) dev     - Development (base + rust, mise, node)"
  echo "  3) full    - Full setup (dev + unattended-upgrades, docker, chrony)"
  echo "  4) minimal - Minimal packages only"
  echo "  5) custom  - Enter custom tags"
  echo ""
  printf "Select (1-5): "
  read choice

  echo "${BOLD}Select target:${NC}"
  echo "  1) docker  - Docker test container"
  echo "  2) local  - Run locally"
  echo "  3) remote - Use hosts file"
  echo ""
  printf "Select (1-3): "
  read target

  case $choice in
  1) TAGS="$BASE_TAGS" ;;
  2) TAGS="$DEV_TAGS" ;;
  3) TAGS="$FULL_TAGS" ;;
  4) TAGS="$MINIMAL_TAGS" ;;
  5)
    echo "${BOLD}Available tags:${NC}"
    for tag in $ALL_TAGS; do echo "  $tag"; done
    echo ""
    printf "Enter tags (comma-separated): "
    read TAGS
    ;;
  *)
    echo "Invalid choice"
    exit 1
    ;;
  esac

  case $target in
  1)
    TARGET=docker
    INVENTORY=$(get_docker_inventory)
    ;;
  2)
    TARGET=local
    INVENTORY=$(get_local_inventory)
    ;;
  3)
    TARGET=remote
    echo ""
    echo "${BOLD}Available nodes:${NC}"
    grep -v '^\[' hosts | grep -v '^$' | nl -s ') '
    echo ""
    printf "Select node number: "
    read node_choice
    NODE=$(grep -v '^\[' hosts | grep -v '^$' | sed -n "${node_choice}p")
    if [ -z "$NODE" ]; then
      echo "Invalid selection"
      exit 1
    fi
    printf "sudo password: "
    read -s BECOME_PASSWORD
    echo ""
    INVENTORY=$(get_single_node_inventory "$NODE" "$BECOME_PASSWORD")
    ;;
  *)
    echo "Invalid target"
    exit 1
    ;;
  esac
fi

run_playbook "$INVENTORY" "$TAGS"

# Cleanup
rm -f /tmp/docker_hosts_$$ /tmp/local_hosts_$$ /tmp/single_node_$$ 2>/dev/null
