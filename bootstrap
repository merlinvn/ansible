#!/bin/bash
# Bootstrap script - install ansible and setup new machine
# Usage: ./bootstrap [preset] [target]
#
# Examples:
#   ./bootstrap              # Interactive mode
#   ./bootstrap full local   # Full setup on local machine
#   ./bootstrap dev remote   # Dev setup on remote machine
#   ./bootstrap portable-lab local # Prepare a portable lab host
#   BOOTSTRAP_REPO_URL=... ./bootstrap portable-lab local

set -euo pipefail

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo "${BOLD}Bootstrapping Ansible...${NC}"

# Detect OS
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$ID
else
    OS=$(uname -s | tr '[:upper:]' '[:lower:]')
fi

echo "Detected OS: $OS"

# Install ansible based on OS
install_ansible() {
    case $OS in
        ubuntu|debian)
            echo "${YELLOW}Installing ansible via apt...${NC}"
            sudo apt update
            sudo apt install -y git ansible
            ;;
        fedora|rhel|centos)
            echo "${YELLOW}Installing ansible via dnf...${NC}"
            sudo dnf install -y git ansible
            ;;
        arch)
            echo "${YELLOW}Installing ansible via pacman...${NC}"
            sudo pacman -Sy --noconfirm git ansible
            ;;
        darwin)
            echo "${YELLOW}Installing ansible via brew...${NC}"
            brew install ansible
            ;;
        *)
            echo "Unsupported OS: $OS"
            exit 1
            ;;
    esac
}

# Check if ansible is installed
if ! command -v ansible &> /dev/null; then
    install_ansible
else
    echo "Ansible already installed: $(ansible --version | head -1)"
fi

# Optionally bootstrap from a fresh clone. Leave BOOTSTRAP_REPO_URL unset when
# running this checkout directly.
REPO_URL="${BOOTSTRAP_REPO_URL:-}"
REPO_DIR="${BOOTSTRAP_REPO_DIR:-$PWD}"
if [ -n "$REPO_URL" ]; then
    if [ ! -d "$REPO_DIR/.git" ]; then
        echo "${YELLOW}Cloning infrastructure repository...${NC}"
        git clone "$REPO_URL" "$REPO_DIR"
    else
        echo "Infrastructure repository already exists: $REPO_DIR"
    fi
    cd "$REPO_DIR"
fi

# Run the playbook
echo ""
echo "${BOLD}Running playbook...${NC}"
./run-playbook "$@"
